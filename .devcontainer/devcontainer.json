// A container that builds and runs Game Bits on Linux, such as a GitHub
// Codespace. Programs run from its terminal appear on a desktop viewed in the
// browser, through the forwarded "Desktop" port. See README.md.
{
  "name": "Game Bits",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      // The version CI uses, its VULKAN_SDK_VERSION
      // (.github/workflows/cmake.yml).
      "VULKAN_SDK_VERSION": "1.4.363.1"
    }
  },
  "features": {
    // A light desktop on a VNC server, viewed in the browser through noVNC.
    // Its password is "vscode".
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  "containerEnv": {
    // The desktop's size and color depth. It needs 24-bit color, rather than
    // desktop-lite's default of 16, as Mesa's Vulkan drivers can't present to
    // a 16-bit window. 1920x1080 fits render-check's 1280x800 window.
    "VNC_RESOLUTION": "1920x1080x24"
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Desktop"
    }
  },
  // Lets gdb attach to any of the user's programs (as tools/dump-stacks.sh
  // does), and run programs without address randomization.
  "capAdd": ["SYS_PTRACE"],
  "securityOpt": ["seccomp=unconfined"],
  // Programs render on the CPU, and a full build is 990 steps.
  "hostRequirements": {
    "cpus": 4
  },
  // Also runs when a Codespace prebuild is made, so a prebuilt Codespace starts
  // with its submodules. SDL's history is shallow (.gitmodules), and the
  // others' files are fetched only for the commit checked out.
  "updateContentCommand": "git submodule update --init --jobs 8 --filter=blob:none"
}
