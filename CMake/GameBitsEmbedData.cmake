###############################################################################
## Writes the source file for gb_embed_data (see GameBitsTargetCommands.cmake)
##
## Run by the build with cmake -P, with these set:
##  INPUT   The file whose bytes are embedded
##  OUTPUT  The source file to write
##  HEADER  The generated header's include path, which declares the data
##  NAME    The gb::EmbeddedData variable to define, qualified by its namespace
###############################################################################

file(READ "${INPUT}" _hex HEX)

# One "0xNN," per byte, 16 to a line, then a zero byte that isn't counted.
string(REGEX REPLACE "(................................)" "\\1\n    " _bytes
  "${_hex}")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_bytes}")
string(APPEND _bytes "0x00")

file(WRITE "${OUTPUT}"
"// Generated by gb_embed_data from ${INPUT}

#include \"${HEADER}\"

namespace {

alignas(4) constexpr uint8_t kEmbeddedBytes[] = {
    ${_bytes}};

}  // namespace

constinit const gb::EmbeddedData ${NAME}(
    ::kEmbeddedBytes, sizeof(::kEmbeddedBytes) - 1);
")
